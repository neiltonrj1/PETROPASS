{
  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // O index.html é gerado pelo build — editar aqui não adianta, a próxima
  // compilação sobrescreve. Por isso ele aparece esmaecido e não entra na busca.
  "files.readonlyInclude": { "index.html": true },
  "search.exclude": {
    "index.html": true,
    "node_modules": true,
    "src/js/00-vendor-supabase.js": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "volume.json": "${capture}*.html, *.licao.html, *.questoes.html, *.gabarito.html"
  },
  "html.format.wrapLineLength": 0,
  "editor.wordWrap": "on",
  "[json]": { "editor.tabSize": 1 }
}
